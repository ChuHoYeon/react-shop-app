# Set the default behavior, in case people don't have core.autocrlf set.
# text=auto ensures line endings are normalized to LF in the repo and checked out 
# as OS-specific (CRLF on Windows, LF on Mac/Linux).
* text=auto

# ==============================================================================
# Explicitly declare text files you want to always be normalized
# ==============================================================================
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.scss text
*.html text
*.md text

# ==============================================================================
# Scripts and configs that MUST have specific line endings
# ==============================================================================
# Windows scripts should be CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Bash scripts and configs are safer as LF
*.sh text eol=lf
gradlew text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.env text eol=lf
*.sql text eol=lf

# ==============================================================================
# Denote all files that are truly binary and should not be modified
# ==============================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg text